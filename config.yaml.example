civitai:
  token: "YOUR_CIVITAI_API_TOKEN"

# Where to save the downloaded models
storage:
  # Storage backend configuration
  
  # For local storage (default):
  type: "local"
  path: "/path/to/your/model/archive"
  database_path: "/path/to/your/database.sqlite"
  save_metadata: false # Whether to save metadata files (default: false)
  save_previews: false # Whether to save preview images (default: false)

  # For fuckingfast storage:
  # type: "fuckingfast"
  # path: "your-folder-id"  # Root folder ID
  # auth_token: "your-auth-token"
  # database_path: "/path/to/your/database.sqlite"

  # For Pomf storage (pomf.lain.la):
  # type: "pomf"
  # database_path: "/path/to/your/database.sqlite"
  # Note: 'path' is ignored for pomf since it's a URL-based service
  # Note: 'auth_token' is not used by pomf

# (Keep existing comfyui section if needed for other purposes, or remove if solely an archiver)
comfyui:
  base_model_path: "/path/to/ComfyUI/models" # May become redundant if storage.path is used
